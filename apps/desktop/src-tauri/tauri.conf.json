{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuotaPrism",
  "version": "0.1.0",
  "identifier": "com.quotaprism.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "QuotaPrism", "width": 1080, "height": 760, "minWidth": 800, "minHeight": 600, "visible": true },
      { "label": "panel", "title": "QuotaPrism quick view", "width": 400, "height": 580, "visible": false, "resizable": false, "decorations": false, "skipTaskbar": true, "alwaysOnTop": true, "url": "index.html?panel=1" }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
